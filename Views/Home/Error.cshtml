@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="section" style="padding-top:180px; min-height:60vh;">
    <div class="container text-center">
        <h1 class="section-title">Something went wrong.</h1>
        <p class="section-lead">An unexpected error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p class="text-muted-light"><small>Request ID: <code>@Model.RequestId</code></small></p>
        }
        <a href="/" class="btn btn-glow btn-lg mt-3">Back to Home</a>
    </div>
</section>
